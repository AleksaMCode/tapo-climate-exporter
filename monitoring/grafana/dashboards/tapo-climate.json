        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Time since the exporter last got data from the hub. Readings are dropped after STALE_AFTER_SECONDS."
