TAPO_USERNAME=you@example.com
TAPO_PASSWORD=change-me
# Fixed IP address of the H100 hub on your network.
TAPO_HUB_IP=192.168.1.1

# How often the hub is polled. One request returns all sensors.
POLL_INTERVAL_SECONDS=60
# Extra attempts (exponential backoff) within one poll cycle before the hub is
# reported as down. The next cycle always tries again.
POLL_MAX_RETRIES=3
# Readings older than this are no longer exported.
STALE_AFTER_SECONDS=300
# Timeout for a single request to the hub.
TAPO_REQUEST_TIMEOUT_SECONDS=10
# How many sensors you own. Exposed as tapo_sensors_expected so the dashboard
# can show how many are offline or missing.
EXPECTED_SENSOR_COUNT=5
# Comma-separated sensor names (as set in the Tapo app) or device ids that are
# outside. They are excluded from the whole-home averages.
OUTDOOR_SENSORS=Balcony
# Log level: error, warn, info, debug or trace.
RUST_LOG=info

# How long history is kept, as a rolling window (e.g. 30d, 26w, 1y).
PROMETHEUS_RETENTION=1y
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
